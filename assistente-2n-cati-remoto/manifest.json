{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Assistente 2N",
  "version": "3.2.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "pt_BR",
  "author": "Pedro Machado",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://cati.tjce.jus.br/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://cati.tjce.jus.br/*"],
      "js": [
        "src/content/assyst-scanner.js",
        "src/content/assyst-sla-engine.js",
        "src/content/assyst-sla.js",
        "src/content/assyst-alertas.js",
        "src/content/assyst-downtime.js"
      ],
      "css": [
        "src/content/assyst-scanner.css",
        "src/content/assyst-sla.css",
        "src/content/assyst-alertas.css",
        "src/content/assyst-downtime.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/content/whatsapp-templates.js"
      ],
      "css": [
        "src/content/whatsapp-templates.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": [
      "src/background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "32": "src/assets/icon32.png",
      "48": "src/assets/icon48.png",
      "64": "src/assets/icon64.png"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "32": "src/assets/icon32.png",
    "48": "src/assets/icon48.png",
    "64": "src/assets/icon64.png",
    "96": "src/assets/icon96.png",
    "128": "src/assets/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "assistente-2n-cati-remoto@pedromachado",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/PedroMachado1/extensoes-cati-tjce/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}